/** 登录页面样式 */

body {
    /*background-image: linear-gradient(-180deg, #172c49 0%, #172e4f 100%);*/
    /*background-image: url("../images/bg_login.png");*/
    background-image: url("../images/bg.png");
    background-repeat: no-repeat;
    background-size: cover;
}

.login-wrapper, body, html {
    height: 100%
}

.login-wrapper {
    overflow: auto;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100%;
    overflow: hidden;
    width: 100%;
}

.login-body {
    padding: 10px 10px 40px 10px;
}

.login-body > .layui-card {
    max-width: 560px;
    margin: 0 auto;
    margin-bottom: 15px;
    border-radius: 2px;
    background-color: #a0999926;
    box-shadow: 0 1px 2px 0 rgba(0,0,0,.05);
}

.login-body .layui-card-header {
    font-weight: 700;
    font-size: 15px;
}

.login-body .layui-form-pane .layui-form-label {
    width: 48px;
}

.login-body .layui-form-pane .layui-input-block {
    margin-left: 0px;
}

.username {
    background: url("../images/username.png")no-repeat 428px ;
    width: 462px;
    height: 40px;
    border-radius:5px;
    border: 1px solid #999999;
    box-shadow: 1px 1px 3px #cccccc;
    padding-left: 10px;
    margin-right: 10px;
    color: #b1b5bb;
}

.password {
    background: url("../images/password.png")no-repeat 428px ;
    width: 462px;
    height: 40px;
    border-radius:5px;
    border: 1px solid #999999;
    box-shadow: 1px 1px 3px #cccccc;
    padding-left: 10px;
    margin-right: 10px;
    color: #b1b5bb;
}

.login-body .captcha {
    width: 100%;
    /*cursor: pointer;*/
    line-height: 38px;
    background: url("../images/password.png")no-repeat 428px;
    width: 462px;
    height: 40px;
    border-radius:5px;
    border: 1px solid #999999;
    box-shadow: 1px 1px 3px #cccccc;
    padding-left: 10px;
    margin-right: 10px;
    color: #b1b5bb;
}

.login-body .login-captcha {
    width: 100%;
    cursor: pointer;
    /*margin-left: 30px;*/
    line-height: 38px;
    height: 38px;
    border-radius:5px;
    /*border: 1px solid #999999;*/
    /*box-shadow: 1px 1px 3px #cccccc;*/
    padding-left: 10px;
    margin-right: 10px;
    color: #b1b5bb;
}

.login-body .login-other > * {
    display: inline-block;
    vertical-align: middle;
    margin-right: 10px;
    font-size: 14px;
}

.login-body .login-other .layui-icon {
    position: relative;
    top: 2px;
    font-size: 26px;
}

.login-body .login-other a:hover {
    opacity: .8;
}

.layui-icon-login-qq {
    color: #3492ED
}

.layui-icon-login-wechat {
    color: #4DAF29
}

.layui-icon-login-weibo {
    color: #CF1900
}

.layui-form-pane {
    padding: 2vw;
    border: 3px solid #e6ecf512;
    border-radius: 3px;
    margin: 10px 0;
}

.layui-btn {
    background-color: #1065a6;
}

.layui-form-item {
    margin-bottom: 2vw;
}

/** 底部样式 */
.login-footer {
    text-align: center;
    line-height: 30px;
    color: rgba(255, 255, 255, 0.9) !important;
    padding-bottom: 20px;
}

.login-footer span {
    padding: 0 5px
}

.login-footer a {
    padding: 0 5px;
    color: rgba(255, 255, 255, 0.9) !important;
}

.login-footer a:hover {
    color: rgba(255, 255, 255, 0.4) !important;
}

@media (min-width: 340px) {
    /** 头部样式 */
    .login-header {
        margin-left: 4vw;
        margin-top: 2vw;
        /*position: fixed;*/
        font-size: 20px;
        font-weight: bold;
        color: rgba(255, 255, 255, 0.85) !important;
        padding: 10px;
    }
}
@media (max-width: 340px) {
    .login-header img {
        height: 100%;
    }
}


/** 移动设备样式 */
@media screen and (min-height: 590px) {
    .login-footer {
        position: absolute;
        /*bottom: 0;*/
        width: 100%;
        float: left;
        font-size: 16px;
        text-align: left;
        margin-top: 20px;
        margin-left: 10px;
    }
}

@media (min-width: 1023px) {
    .login-body {
        margin-left: 25%;
    }
    login_title {
        text-align: center;
        margin-bottom: 30px;
    }
    .login_title img{
        width: 100%;
        margin-bottom: 30px;
    }
}

@media (max-width: 1024px) {
    login_title {
        text-align: center;
        margin-bottom: 10px;
    }
    .login_title img{
        width: 100%;
        margin-bottom: 30px;
    }
}

.login_title {
    text-align: center;
    margin-bottom: 30px;
}

@media screen and (min-height: 670px) {
    .login-body {
        padding: 110px 10px 40px 10px;
    }
}

/** 辅助样式 */
.layui-link {
    color: #029789 !important;
}

.layui-link:hover {
    opacity: .8;
}

.pull-right {
    float: right;
}

.inline-block {
    display: inline-block;
}

.osc_git_box {
    background-color: #fff;
    margin-top: 20px;
}

.login-header {
    color: rgba(0, 0, 0, .85) !important;
}

.login-footer {
    color: rgba(255, 255, 255, 0.7) !important;
}

.login-footer a {
    color: rgba(255, 255, 255, 0.7) !important;
}

.login-footer a:hover {
    color: rgba(255, 255, 255, 0.4) !important;
}