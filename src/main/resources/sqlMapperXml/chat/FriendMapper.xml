<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.mapper.chat.FriendMapper" >
 <select id="getFriendList" parameterType="java.lang.Long" resultType="com.model.wechat.WxUser">
 	select * from wxuser where userId in(select wxuserId from friend where userId=#{userId})
 </select>
</mapper>